{
  "name": "pi-transcript-search",
  "version": "0.1.0",
  "description": "Fast, local, evidence-bearing search for Pi conversation transcripts",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odfalik/pi-transcript-search.git"
  },
  "bugs": {
    "url": "https://github.com/odfalik/pi-transcript-search/issues"
  },
  "homepage": "https://github.com/odfalik/pi-transcript-search#readme",
  "keywords": [
    "pi-package",
    "pi",
    "transcript",
    "conversation",
    "search",
    "agent"
  ],
  "files": [
    "extensions",
    "skills",
    "src/pi_transcript_search/*.py",
    "src/pi_transcript_search/bundled_skill/SKILL.md",
    "runner.py",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.23",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/extension-smoke.mjs",
    "check": "tsc --noEmit && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
